# ---------------------------------------------------------------------------
# E-Commerce Agent - environment template
# Copy to `.env` and fill in. `.env` is gitignored.
#
# Note what is NOT here: any database credential. The agent reaches the
# database only through MCP Toolbox, which holds the credentials itself. The
# agent process cannot leak what it never had.
# ---------------------------------------------------------------------------

# --- Option A: Vertex AI ---------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Option B: Google AI Studio -------------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-ai-studio-api-key

# --- Model -----------------------------------------------------------------
AGENT_MODEL=gemini-2.5-flash

# --- MCP Toolbox (the only path to the database) --------------------------
ENABLE_TOOLBOX=true
TOOLBOX_URL=http://127.0.0.1:5000
# Use `storefront_browse_only` for a public kiosk: the personal-data and write
# tools are then not served at all, enforced by the server rather than by the
# prompt.
TOOLBOX_TOOLSET=storefront

# --- Identity --------------------------------------------------------------
# Google OAuth client ID. Used to verify the *audience* of the ID token, which
# is what makes it a verification rather than a decode: without it, a valid
# Google token minted for any other application would authenticate a user here.
# Must match `clientId` in deployment/toolbox/tools.yaml.
GOOGLE_CLIENT_ID=
# Allow unauthenticated browsing of the catalogue. Writes and personal data
# always require a verified identity regardless of this setting.
ALLOW_GUEST_BROWSING=true

# --- Sessions --------------------------------------------------------------
# A SQLAlchemy URL enables DatabaseSessionService. Leave unset for in-memory
# sessions, which are lost on restart and NOT shared between replicas - fine
# locally, wrong for any deployment with more than one instance.
# SESSION_DB_URL=postgresql+psycopg2://user:pass@host:5432/sessions
SESSION_DB_URL=

# --- Commerce rules (all arithmetic is done in code, never by the model) ---
CURRENCY=EUR
CURRENCY_SYMBOL=€
TAX_RATE_PERCENT=21.0
# Whether catalogue prices already include tax. Getting this wrong is a
# real-money bug, so it is explicit rather than assumed.
PRICES_INCLUDE_TAX=true
FREE_SHIPPING_THRESHOLD=75.00
MAX_CART_QUANTITY=10

# --- Backend ---------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
