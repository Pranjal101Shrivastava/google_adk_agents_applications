          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "The Storm Shell Jacket in M is out of stock in every store right now. It is in the catalogue at €549.00, so it should come back - I just cannot promise when. Would you like me to suggest something else waterproof?"
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [{ "name": "check-stock", "args": {} }],
            "intermediate_responses": []
          }
        }
      ],
      "session_input": {
        "app_name": "ecommerce_agent",
        "user_id": "guest",
        "state": { "is_authenticated": false }
