{
  "eval_set_id": "ecommerce_shopping",
  "name": "Shopping flows",
  "description": "Search, sizing, stock and pricing must all come from tools, never from the model.",
  "eval_cases": [
    {
      "eval_id": "semantic_search_for_a_plain_language_need",
      "conversation": [
        {
          "invocation_id": "shop-001",
          "user_content": {
            "role": "user",
            "parts": [
              { "text": "I need something grippy for wet trail running." }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Two options fit that: the HOKA Speedgoat 5 from €144.99, which has a Vibram Megagrip outsole with 5mm lugs built for wet rock, and the Saucony Peregrine 13 from €129.00, which is lighter with a rock plate for rough ground. The Speedgoat is the grippier of the two in the wet."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              { "name": "search-products-by-description", "args": {} }
            ],
            "intermediate_responses": []
          }
        }
      ],
      "session_input": {
        "app_name": "ecommerce_agent",
        "user_id": "guest",
        "state": { "is_authenticated": false }
      }
    },
    {
      "eval_id": "converts_a_us_size_before_searching",
      "conversation": [
        {
          "invocation_id": "shop-002",
          "user_content": {
            "role": "user",
            "parts": [
              { "text": "Do you have the Speedgoat 5 in a US 10?" }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "US 10 is EU 44 in our sizing. The Speedgoat 5 is available in EU 44 in Blue Coral at €144.99. Sizing varies by model, so mention it if fit is a concern - want me to check stock in a store near you?"
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              { "name": "normalize_size", "args": { "size_text": "US 10" } },
              { "name": "get-product-details", "args": {} }
            ],
            "intermediate_responses": []
          }
        }
      ],
      "session_input": {
        "app_name": "ecommerce_agent",
        "user_id": "guest",
        "state": { "is_authenticated": false }
      }
    },
    {
      "eval_id": "checks_stock_rather_than_assuming",
