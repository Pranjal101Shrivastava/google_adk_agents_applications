# ---------------------------------------------------------------------------
# Gemini CLI Tool Agent - environment template
# Copy to `.env` and fill in. `.env` is gitignored.
#
# Requires the Gemini CLI on PATH:  npm install -g @google/gemini-cli
# ---------------------------------------------------------------------------

# --- Option A: Vertex AI ---------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Option B: Google AI Studio -------------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-ai-studio-api-key

# --- ADK agent models ------------------------------------------------------
# Planning and synthesis - the steps where reasoning quality pays for itself.
ORCHESTRATOR_MODEL=gemini-2.5-pro
# Intake, scouting, execution bookkeeping.
WORKER_MODEL=gemini-2.5-flash

# --- Gemini CLI ------------------------------------------------------------
# Binary name (resolved on PATH) or an absolute path.
GEMINI_CLI_BINARY=gemini
# The model the CLI itself uses, passed through as `-m`.
GEMINI_CLI_MODEL=gemini-2.5-pro
# Wall-clock ceiling for one CLI invocation (10-3600 s).
GEMINI_CLI_TIMEOUT_SECONDS=600
# CLI stdout re-enters a model prompt, so it is truncated to this length.
GEMINI_CLI_MAX_OUTPUT_CHARS=60000
# Allow the CLI to modify files (adds --yolo). Leave false for analysis-only
# deployments; this is the single most important setting in this file.
GEMINI_CLI_ALLOW_WRITE=false

# --- Checkout sandbox ------------------------------------------------------
# Where clones live. On Cloud Run this is tmpfs, so it costs instance memory.
WORKSPACE_ROOT=/tmp/gemini-cli-agent
# Comma-separated git hosts the agent may clone from. An empty value is
# rejected at startup rather than silently meaning "allow everything".
ALLOWED_CLONE_HOSTS=github.com,gitlab.com,bitbucket.org
CLONE_TIMEOUT_SECONDS=300
CLONE_DEPTH=1
MAX_WORKSPACE_MB=512
MAX_CONCURRENT_WORKSPACES=5

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
