# ---------------------------------------------------------------------------
# Deep Research Lead Generation Agent - environment template
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# ---------------------------------------------------------------------------

# --- Option A: Vertex AI (recommended for anything beyond a demo) ----------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Staging bucket, required only for Agent Engine deployment.
GOOGLE_CLOUD_STORAGE_BUCKET=your-staging-bucket

# --- Option B: Google AI Studio (quick local start) ------------------------
# Comment out the Vertex block above and uncomment these two instead.
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-ai-studio-api-key

# --- Model routing ---------------------------------------------------------
# Cheap model for extraction, formatting and validation steps.
GEN_FAST_MODEL=gemini-2.5-flash
# Reasoning model for planning, research and synthesis.
GEN_ADVANCED_MODEL=gemini-2.5-pro

# --- Research breadth and depth -------------------------------------------
# Reference companies studied during pattern discovery (1-15).
DEFAULT_PATTERN_COMPANIES=5
# Candidate leads qualified during lead generation (1-25).
DEFAULT_LEAD_CANDIDATES=8
# Refinement passes of the research critic loop (1-5).
MAX_RESEARCH_ITERATIONS=2
# Minimum fit score (0-100) for a lead to be reported as qualified.
MIN_QUALIFIED_SCORE=55

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
