# ---------------------------------------------------------------------------
# Code Review Assistant - environment template
# Copy to `.env` and fill in. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- Option A: Vertex AI ---------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Only needed for Agent Engine deployment.
STAGING_BUCKET=your-staging-bucket
# Optional GCS bucket for review artifacts; in-memory if unset.
ARTIFACT_BUCKET=

# --- Option B: Google AI Studio -------------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-ai-studio-api-key

# --- Models ----------------------------------------------------------------
# Mechanical stages: structure, style, security.
WORKER_MODEL=gemini-2.5-flash
# Judgement stages: test authoring, feedback, fixing, validation.
CRITIC_MODEL=gemini-2.5-pro

# --- Grading weights (MUST sum to 1.0, validated at startup) ---------------
# These decide what the review optimises for. Change them to match your
# team's priorities; a bad sum fails fast rather than skewing every score.
CORRECTNESS_WEIGHT=0.40
SECURITY_WEIGHT=0.25
STYLE_WEIGHT=0.20
STRUCTURE_WEIGHT=0.15

# --- Review thresholds -----------------------------------------------------
PASSING_SCORE=70
MAX_LINE_LENGTH=100
# Functions above this cyclomatic complexity are flagged.
MAX_COMPLEXITY=10
MAX_FUNCTION_LINES=50

# --- Code execution --------------------------------------------------------
# Set to false to review statically. Correctness is then reported as
# "not assessed" and its weight is redistributed - never scored as zero.
ENABLE_CODE_EXECUTION=true
EXECUTION_TIMEOUT_SECONDS=30
EXECUTION_CPU_SECONDS=20
EXECUTION_MEMORY_MB=512
MAX_CODE_CHARS=200000

# --- Fix loop --------------------------------------------------------------
MAX_FIX_ATTEMPTS=3

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
