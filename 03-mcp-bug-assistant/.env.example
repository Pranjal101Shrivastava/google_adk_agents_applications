# ---------------------------------------------------------------------------
# MCP Bug Assistant - environment template
# Copy to `.env` and fill in. `.env` is gitignored.
#
# Every integration below is optional. With none of them configured the agent
# still starts and still works - it just tells you which capabilities it does
# not have, instead of guessing.
# ---------------------------------------------------------------------------

# --- Option A: Vertex AI ---------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Option B: Google AI Studio -------------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-ai-studio-api-key

# --- Models ----------------------------------------------------------------
AGENT_MODEL=gemini-2.5-flash
SEARCH_MODEL=gemini-2.5-flash

# --- Ticket database, via MCP Toolbox for Databases ------------------------
ENABLE_TOOLBOX=true
MCP_TOOLBOX_URL=http://127.0.0.1:5000
# Use `tickets_readonly_toolset` for a deployment that must never write.
# The restriction is then enforced by the Toolbox server, not by the prompt.
MCP_TOOLBOX_TOOLSET=tickets_toolset

# --- GitHub MCP server -----------------------------------------------------
# Without a token the GitHub tools are left out and the agent says so.
# A fine-grained token with read-only repository contents + issues is enough.
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# Comma-separated allowlist. Keep it read-only: a bug assistant has no business
# closing issues or pushing branches on its own.
GITHUB_TOOL_FILTER=search_repositories,search_issues,list_issues,get_issue,list_pull_requests,get_pull_request,get_file_contents,search_code

# --- Stack Overflow --------------------------------------------------------
ENABLE_STACKOVERFLOW=true
STACKEXCHANGE_SITE=stackoverflow
# Optional. Raises the quota from 300/day (anonymous) to 10,000/day.
STACKEXCHANGE_KEY=
STACKEXCHANGE_TIMEOUT_SECONDS=15
STACKEXCHANGE_MAX_RESULTS=5

# --- Built-in web search ---------------------------------------------------
ENABLE_GOOGLE_SEARCH=true

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
