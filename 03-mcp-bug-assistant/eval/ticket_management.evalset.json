            "role": "user",
            "parts": [
              {
                "text": "File a bug: the settings page 404s for users on the legacy plan."
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "I found no existing ticket for this, so it looks new. Before I create it, confirm: title \"Settings page returns 404 for legacy-plan users\", priority P2 - Medium, unassigned. Is that right, and do you know whether there is a workaround? That changes the priority."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [{ "name": "search-tickets", "args": {} }],
            "intermediate_responses": []
          }
        }
      ],
      "session_input": {
        "app_name": "software_bug_assistant",
        "user_id": "eval-user",
        "state": {}
      }
    },
